# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# GitHub Personal Access Token (classic with 'repo' scope, or fine-grained with Actions: Read & Write)
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub repository in format: owner/repo
GITHUB_REPO=your-username/vibe-apk-builder

# GitHub Actions workflow file name or ID
GITHUB_WORKFLOW_ID=build_apk.yml

# Target branch
GITHUB_BRANCH=main
